{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/skill-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "inputs", "outputs", "permissions"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "plan.read",
          "plan.write",
          "task.dispatch",
          "task.execute",
          "artifact.write",
          "artifact.read",
          "approval.request",
          "approval.consume"
        ]
      }
    },
    "entrypoint": { "type": "string" }
  }
}
