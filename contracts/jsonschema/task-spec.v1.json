{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/task-spec.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "workflow_id", "task_type", "capabilities"],
  "properties": {
    "task_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "task_type": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "payload": { "type": "object" }
  }
}
